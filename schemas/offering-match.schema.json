{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sales-copilot.local/schemas/offering-match.schema.json",
  "title": "Account offering match hypotheses",
  "description": "Evidence-linked candidate offering references for an account. These are hypotheses, not approved recommendations.",
  "type": "object",
  "additionalProperties": false,
  "required": ["account_id", "matches"],
  "properties": {
    "account_id": { "type": "string", "pattern": "^(acct|sf)_[A-Za-z0-9_-]+$" },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["offering_id", "match_status", "claim_ids", "evidence_ids"],
        "properties": {
          "offering_id": { "type": "string", "pattern": "^off_[A-Za-z0-9_-]+$" },
          "match_status": { "enum": ["candidate_hypothesis"] },
          "claim_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^clm_[A-Za-z0-9_-]+$" } },
          "evidence_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^clm_[A-Za-z0-9_-]+$" } },
          "signal_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^sig_[A-Za-z0-9_-]+$" } }
        }
      }
    }
  }
}
