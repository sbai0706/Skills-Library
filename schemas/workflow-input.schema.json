{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sales-copilot.local/schemas/workflow-input.schema.json",
  "title": "prepare-first-meeting workflow input",
  "description": "Input contract for the fixed prepare-first-meeting workflow. Only account_reference is required; the workflow applies the documented defaults and then validates the normalized input.",
  "type": "object",
  "additionalProperties": false,
  "required": ["account_reference"],
  "properties": {
    "account_reference": {
      "type": "string",
      "minLength": 1,
      "description": "Free-text account reference resolved by account.resolve. A partial or fuzzy reference blocks for confirmation."
    },
    "questions": {
      "type": ["array", "null"],
      "minItems": 1,
      "description": "Optional active question set. Null or omitted uses the draft reference question set.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          }
        },
        "anyOf": [
          { "properties": { "text": {} }, "required": ["text"] },
          { "properties": { "question": {} }, "required": ["question"] }
        ]
      }
    },
    "requested_sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["crm", "public_source", "internal_document"]
      }
    },
    "audience": {
      "enum": ["internal_sales", "executive", "customer"]
    },
    "template_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{1,63}$"
    },
    "classification_ceiling": {
      "enum": ["public", "internal", "confidential"]
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requested_by": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "permitted_classifications": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["public", "internal", "confidential"]
          }
        }
      }
    }
  }
}
