{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sales-copilot.local/schemas/prepare-engagement-result.schema.json",
  "title": "prepare-engagement workflow result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflow",
    "workflow_version",
    "mode",
    "status",
    "account",
    "artifact",
    "engagement",
    "evidence_ids",
    "warnings",
    "errors",
    "steps",
    "trace_id",
    "started_at",
    "finished_at"
  ],
  "properties": {
    "workflow": { "const": "prepare-engagement" },
    "workflow_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "mode": { "enum": ["initial", "follow_up", null] },
    "status": { "enum": ["success", "partial", "blocked", "failed"] },
    "account": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["account_id", "canonical_name"],
          "properties": {
            "account_id": { "type": "string", "minLength": 1 },
            "canonical_name": { "type": "string", "minLength": 1, "maxLength": 300 },
            "identifiers": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "domain": { "type": "string", "minLength": 1 },
                "external_id": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      ]
    },
    "artifact": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "template_id", "classification", "markdown"],
          "properties": {
            "format": { "const": "markdown" },
            "template_id": { "const": "engagement-draft-v1" },
            "classification": { "enum": ["public", "internal", "confidential"] },
            "markdown": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "engagement": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "https://sales-copilot.local/schemas/engagement-draft-data.schema.json" }
      ]
    },
    "evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^clm_[A-Za-z0-9_-]+$" }
    },
    "warnings": {
      "type": "array",
      "items": { "$ref": "#/definitions/diagnostic" }
    },
    "errors": {
      "type": "array",
      "items": { "$ref": "#/definitions/diagnostic" }
    },
    "steps": {
      "type": "array",
      "items": { "$ref": "#/definitions/stepSummary" }
    },
    "trace_id": { "type": "string", "pattern": "^trace_" },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" }
  },
  "definitions": {
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "skill", "code", "message"],
      "properties": {
        "step": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
        "skill": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" }
      }
    },
    "stepSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "skill", "status"],
      "properties": {
        "step": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
        "skill": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
        "status": { "enum": ["success", "partial", "blocked", "failed"] },
        "warning_codes": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "error_codes": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "enum": ["success", "partial"] } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "errors": { "type": "array", "maxItems": 0 },
          "account": { "type": "object" },
          "artifact": { "type": "object" },
          "engagement": { "type": "object" }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "enum": ["failed", "blocked"] } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "errors": { "type": "array", "minItems": 1 },
          "artifact": { "type": "null" },
          "engagement": { "type": "null" },
          "evidence_ids": { "type": "array", "maxItems": 0 }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "success" } },
        "required": ["status"]
      },
      "then": { "properties": { "mode": { "enum": ["initial", "follow_up"] } } }
    }
  ]
}
