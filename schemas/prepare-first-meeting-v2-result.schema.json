{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sales-copilot.local/schemas/prepare-first-meeting-v2-result.schema.json",
  "title": "prepare-first-meeting-v2 result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflow",
    "workflow_version",
    "status",
    "account",
    "account_candidates",
    "artifact",
    "account_intelligence",
    "evidence_ids",
    "warnings",
    "errors",
    "steps",
    "trace_id",
    "started_at",
    "finished_at"
  ],
  "properties": {
    "workflow": { "const": "prepare-first-meeting-v2" },
    "workflow_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "enum": ["success", "partial", "blocked", "failed"] },
    "account": { "$ref": "https://sales-copilot.local/schemas/workflow-result.schema.json#/properties/account" },
    "account_candidates": { "$ref": "https://sales-copilot.local/schemas/workflow-result.schema.json#/properties/account_candidates" },
    "artifact": { "$ref": "https://sales-copilot.local/schemas/workflow-result.schema.json#/properties/artifact" },
    "account_intelligence": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["signals", "stakeholder_map", "offering_matches", "reference_status"],
      "properties": {
        "signals": { "$ref": "https://sales-copilot.local/schemas/signal-result.schema.json" },
        "stakeholder_map": { "$ref": "https://sales-copilot.local/schemas/stakeholder-map.schema.json" },
        "offering_matches": { "$ref": "https://sales-copilot.local/schemas/offering-match.schema.json" },
        "reference_status": {
          "type": "object",
          "additionalProperties": false,
          "required": ["signal_taxonomy", "personas", "offerings"],
          "properties": {
            "signal_taxonomy": { "$ref": "#/definitions/referenceStatus" },
            "personas": { "$ref": "#/definitions/referenceStatus" },
            "offerings": { "$ref": "#/definitions/referenceStatus" }
          }
        }
      }
    },
    "evidence_ids": { "$ref": "https://sales-copilot.local/schemas/workflow-result.schema.json#/properties/evidence_ids" },
    "warnings": { "$ref": "https://sales-copilot.local/schemas/workflow-result.schema.json#/properties/warnings" },
    "errors": { "$ref": "https://sales-copilot.local/schemas/workflow-result.schema.json#/properties/errors" },
    "steps": { "$ref": "https://sales-copilot.local/schemas/workflow-result.schema.json#/properties/steps" },
    "trace_id": { "type": "string", "pattern": "^trace_" },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" }
  },
  "definitions": {
    "referenceStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "status"],
      "properties": {
        "version": { "type": ["string", "null"], "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "status": { "enum": ["approved", "provisional", "unknown"] }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "enum": ["blocked", "failed"] } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "artifact": { "type": "null" },
          "account_intelligence": { "type": "null" },
          "evidence_ids": { "type": "array", "maxItems": 0 },
          "errors": { "type": "array", "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "enum": ["success", "partial"] } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "artifact": { "type": "object" },
          "account_intelligence": { "type": "object" }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "success" } },
        "required": ["status"]
      },
      "then": {
        "properties": { "errors": { "type": "array", "maxItems": 0 } }
      }
    }
  ]
}
